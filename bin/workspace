#!/usr/bin/env bash
# Create, re-attach to, or remove a named workspace.
#
#   workspace <name>                    create the workspace, or re-attach to it
#   workspace <name> --models-file <file>  import pi's models.json; --replace-models to overwrite
#                                       export OPENAI_API_KEY to make it available in new tmux shells
#   workspace <name> --mount <dir>      mount <dir> instead of the default folder; create it if missing
#                                       project files go in ~/workspaces/<name> (WORKSPACE_ROOT)
#                                       asks which skill sets to install; set WORKSPACE_SKILLS
#                                       (e.g. mattpocock,openspec) to skip the question
#   workspace rm <name>                 remove the container, keep its volume
#   workspace purge <name>              remove the container and its volume
set -euo pipefail

IMAGE="${WORKSPACE_IMAGE:-localhost/dev-workspace:latest}"
OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-http://host.containers.internal:11434/v1}"

print_usage() {
  printf '%s\n' \
    'usage: workspace [--verbose] <name> [--mount <dir>] [--models-file <file>] [--replace-models]' \
    '       workspace [--verbose] ls' \
    '       workspace [--verbose] rm <name>' \
    '       workspace [--verbose] purge <name>' \
    '       workspace -h | --help' \
    '' \
    'Options:' \
    '  --mount <dir>         Mount a project folder; create it if missing (creation only).' \
    '  --models-file <file>  Copy a models.json into persistent pi configuration.' \
    '  --replace-models      Allow replacing a different existing models.json.' \
    '  --verbose             Print Podman commands to stderr before running them.' \
    '  -h, --help            Show this help and exit.' \
    '' \
    'Export OPENAI_API_KEY to forward it to new tmux shells (not saved in models.json).'
}

# An EXIT trap covers both explicit validation errors and unexpected command
# failures. Do not print command arguments here: they may contain credentials.
on_exit() {
  local status=$?
  if [ "$status" -ne 0 ]; then
    printf 'workspace: failed (exit status %s).\n\n' "$status" >&2
    print_usage >&2
  fi
}
trap on_exit EXIT

usage() {
  echo "workspace: invalid usage; check the arguments and required option values" >&2
  exit 2
}

verbose=false
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --verbose) verbose=true; shift ;;
    -h|--help) print_usage; exit 0 ;;
    --mount|--models-file)
      [ $# -ge 2 ] || usage
      args+=("$1" "$2")
      shift 2
      ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]}"

log_podman() {
  if "$verbose"; then
    printf '+ podman' >&2
    printf ' %q' "$@" >&2
    printf '\n' >&2
  fi
}

check_name() {
  [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || { echo "workspace: invalid name '$1'" >&2; exit 2; }
}

[[ $# -ge 1 ]] || usage

if [ -z "${OPENAI_API_KEY:-}" ]; then
  echo "workspace: warning: OPENAI_API_KEY is not set or is empty; it will not be forwarded to the workspace." >&2
  echo 'For API-key authentication, run: export OPENAI_API_KEY="your-token"' >&2
  echo "Then reconnect and start pi in a new tmux window/pane. Other authentication methods may still work." >&2
fi

case "$1" in
  ls)
    [[ $# -eq 1 ]] || usage
    log_podman ps -a --filter "name=^ws-" --format "table {{.Names}}\t{{.Status}}"
    podman ps -a --filter "name=^ws-" --format "table {{.Names}}\t{{.Status}}" | sed 's/^ws-//'
    exit 0
    ;;
  rm|purge)
    [[ $# -eq 2 ]] || usage
    check_name "$2"
    log_podman rm -f "ws-$2"
    podman rm -f "ws-$2" >/dev/null 2>&1 || true
    if [ "$1" = purge ]; then
      log_podman volume rm "ws-$2"
      podman volume rm "ws-$2"
    fi
    exit 0
    ;;
esac

name="$1"
shift
check_name "$name"
container="ws-$name"

project_dir=""
models_file=""
replace_models=false
while [ $# -gt 0 ]; do
  case "$1" in
    --mount)
      [ $# -ge 2 ] || usage
      [ -n "$2" ] || usage
      project_dir="$(realpath -m -- "$2")"
      if [ -e "$project_dir" ] && [ ! -d "$project_dir" ]; then
        echo "workspace: --mount path is not a directory: $project_dir" >&2
        exit 2
      fi
      shift 2
      ;;
    --models-file)
      [ $# -ge 2 ] || usage
      models_file="$(realpath -e "$2")"
      shift 2
      ;;
    --replace-models) replace_models=true; shift ;;
    *) usage ;;
  esac
done
if "$replace_models" && [ -z "$models_file" ]; then usage; fi

# Validate only the basic structure; pi validates API-specific fields itself.
# Slurp to reject files containing multiple JSON documents. Never print file
# contents in errors: a supplied configuration could contain literal secrets.
models_filter='
  length == 1 and (.[0] |
    type == "object" and (.providers | type == "object") and
    all(.providers[];
      type == "object" and
      (if has("models") then
        .models | type == "array" and all(.[];
          type == "object" and (.id | type == "string" and length > 0))
      else true end)))
'
if [ -n "$models_file" ]; then
  if [ ! -f "$models_file" ] || [ ! -r "$models_file" ]; then
    echo "workspace: --models-file must be a readable regular file" >&2
    exit 2
  fi
  if ! command -v jq >/dev/null; then
    echo "workspace: --models-file needs jq, a JSON validation tool, installed on your Ubuntu host." >&2
    echo "Install it with: sudo apt-get update && sudo apt-get install -y jq" >&2
    echo "Then run your workspace command again." >&2
    exit 2
  fi
  if ! jq -e -s "$models_filter" "$models_file" >/dev/null 2>&1; then
    echo "workspace: invalid models.json; expected one JSON object with a providers object and valid model IDs" >&2
    exit 2
  fi
fi

# Ask once, at creation, for the git identity. Defaults to the host's.
ask() {
  local answer
  read -r -p "$1${2:+ [$2]}: " answer || true
  echo "${answer:-$2}"
}

# Ask which skill sets the workspace gets. Prints the chosen ids, comma-separated.
choose_skill_sets() {
  local ids=(mattpocock pstack superpowers addyosmani openspec)
  local labels=("Matt Pocock's skills" "PStack" "Superpowers" "Addy Osmani's agent-skills" "OpenSpec (CLI)")
  local i answer picked=() n
  for i in "${!ids[@]}"; do echo "  $((i + 1))) ${labels[$i]}" >&2; done
  read -r -p "Skill sets to install, e.g. 1,3 (empty for none): " answer || true
  for n in $(echo "$answer" | tr ',' ' '); do
    if [[ "$n" =~ ^[1-5]$ ]]; then picked+=("${ids[$((n - 1))]}"); else echo "workspace: ignoring '$n'" >&2; fi
  done
  (IFS=,; echo "${picked[*]-}")
}

log_podman container exists "$container"
container_exists=false
if podman container exists "$container"; then
  container_exists=true
else
  status=$?
  # Status 1 means absent; other statuses indicate a Podman failure.
  [ "$status" -eq 1 ] || exit "$status"
fi
if ! "$container_exists"; then
  git_name="$(git config --global user.name 2>/dev/null || true)"
  git_email="$(git config --global user.email 2>/dev/null || true)"
  if [ -t 0 ]; then
    git_name="$(ask "Git user.name" "$git_name")"
    git_email="$(ask "Git user.email" "$git_email")"
  fi
  skill_sets="${WORKSPACE_SKILLS-}"
  if [ -z "${WORKSPACE_SKILLS+x}" ] && [ -t 0 ]; then
    skill_sets="$(choose_skill_sets)"
  fi
  folder="${WORKSPACE_FOLDER-}"
  if [ -z "${WORKSPACE_FOLDER+x}" ] && [ -t 0 ]; then
    folder="$(ask "Folder name in the workspace's home for the project files" project)"
  fi
  folder="${folder:-project}"
  check_name "$folder"
  # Only create folders after validating creation settings and confirming the
  # container does not exist. Keep project files on Linux, not /mnt/c.
  if [ -z "$project_dir" ]; then
    project_dir="${WORKSPACE_ROOT:-$HOME/workspaces}/$name"
    mkdir -p "$project_dir"
  elif [ ! -d "$project_dir" ]; then
    if ! mkdir -p -- "$project_dir"; then
      echo "workspace: could not create --mount directory: $project_dir" >&2
      exit 1
    fi
    echo "workspace: warning: created missing --mount directory: $project_dir" >&2
  fi
  create_args=(
    run -d --name "$container" --hostname "$name"
    --userns=keep-id
    -v "$container:/home/dev"
    -v "$project_dir:/home/dev/$folder"
    --label "workspace.folder=$folder"
    -e OLLAMA_BASE_URL="$OLLAMA_BASE_URL"
    -e GIT_USER_NAME="$git_name"
    -e GIT_USER_EMAIL="$git_email"
    -e SKILL_SETS="$skill_sets"
  )
  # Skip the default Ollama file while a supplied configuration is being imported.
  if [ -n "$models_file" ]; then create_args+=(-e WORKSPACE_MODELS_IMPORT=1); fi
  create_args+=("$IMAGE")
  log_podman "${create_args[@]}"
  podman "${create_args[@]}" >/dev/null
elif [ -n "$project_dir" ]; then
  echo "workspace: '$name' already exists; mounts are set at creation. Run 'workspace rm $name' first." >&2
  exit 1
fi

log_podman start "$container"
podman start "$container" >/dev/null
if [ -n "$models_file" ]; then
  # Stage and validate inside the volume, then atomically replace the target.
  # The JSON is sent on stdin, unchanged and without expanding credentials.
  import_script='
    set -eu
    umask 077
    dir="$HOME/.pi/agent"
    mkdir -p "$dir"
    staged="$(mktemp "$dir/.models.json.XXXXXX")"
    trap '\''rm -f "$staged"'\'' EXIT
    trap '\''exit 1'\'' HUP INT TERM
    cat > "$staged"
    if ! jq -e -s "$2" "$staged" >/dev/null 2>&1; then
      echo "workspace: invalid models.json; import cancelled" >&2
      exit 2
    fi
    target="$dir/models.json"
    if [ -e "$target" ] || [ -L "$target" ]; then
      if cmp -s "$staged" "$target"; then exit 0; fi
      if [ "$1" != true ]; then
        echo "workspace: models.json already exists and differs; use --replace-models to overwrite it" >&2
        exit 1
      fi
    fi
    mv -fT "$staged" "$target"
  '
  import_args=(exec -i "$container" sh -c "$import_script" import-models "$replace_models" "$models_filter")
  log_podman "${import_args[@]}"
  podman "${import_args[@]}" < "$models_file"
  echo "workspace: pi models imported from $models_file" >&2
fi
if [ -n "$project_dir" ]; then
  echo "workspace: project files are in $project_dir (/home/dev/$folder in the workspace)" >&2
  if [ -n "${WSL_DISTRO_NAME:-}" ] && command -v wslpath >/dev/null; then
    echo "workspace: from Windows: $(wslpath -w "$project_dir")" >&2
  fi
fi
# New tmux sessions start in the project folder. Workspaces created before the
# folder was recorded have no label and start in the home folder.
log_podman inspect -f '{{index .Config.Labels "workspace.folder"}}' "$container"
folder="$(podman inspect -f '{{index .Config.Labels "workspace.folder"}}' "$container")"
connect_args=(exec -it -w "/home/dev${folder:+/$folder}")
# Passing the variable name lets Podman resolve the host value without including
# the token in command arguments, verbose output, or container configuration.
if [ -n "${OPENAI_API_KEY:-}" ]; then connect_args+=(-e OPENAI_API_KEY); fi
# tmux.conf updates the session environment on attach. Existing shells keep
# their environment; new panes receive the current key.
connect_args+=("$container" tmux new -A -s main)
log_podman "${connect_args[@]}"
# Keep the parent shell so a failed connection also runs the EXIT help handler.
podman "${connect_args[@]}"
